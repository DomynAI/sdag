# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,markdown,Rmd}]
indent_size = 1
trim_trailing_whitespace = false

[*.{yaml,yml,json}]
indent_size = 2

[Makefile]
indent_style = tab

[{docs/**,**/banner.rs}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
